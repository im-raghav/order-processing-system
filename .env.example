# Copy to .env and adjust as needed. Used by docker-compose for interpolation.

MYSQL_ROOT_PASSWORD=root_password
MYSQL_USER=app
MYSQL_PASSWORD=app_password

# Per-service HTTP ports (host-side)
ORDER_SERVICE_PORT=3001
INVENTORY_SERVICE_PORT=3002
PAYMENT_SERVICE_PORT=3003
SHIPPING_SERVICE_PORT=3004
COORDINATOR_PORT=3000
NOTIFICATION_SERVICE_PORT=3005
FRONTEND_PORT=4200

# How often the shipped-orders notification scan runs, in milliseconds.
# Default is every 15 minutes per the spec; override to something small
# (e.g. 5000) to demo the exactly-once behavior quickly.
NOTIFICATION_SCAN_INTERVAL_MS=900000
